# Copy to .env and fill in. Never commit the real file.

# --- LLM providers (brain only) ---
ELEVATE_TEAM_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# --- Experiment tracking (workers, labml) — optional, offline mode if absent ---
WANDB_API_KEY=

# --- Internal secrets, generated by `just init` ---
LABD_BRAIN_SECRET=
LABD_PAIRING_SECRET=

# --- Mode ---
# live (default) | replay | llm-replay
POKELAB_MODE=live
